# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai-chart-scanner
# For production, use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai-chart-scanner

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRE=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI Provider Configuration
AI_PROVIDER=openai
# Options: 'openai' | 'claude' | 'gemini' | 'custom'

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-vision-preview

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro-vision

# NVIDIA AI — open-source vision/text models via NVIDIA NIM (build.nvidia.com).
# OpenAI-compatible API. Manageable from the admin dashboard.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Vision engine provider (Computer Vision perception). Defaults to AI_PROVIDER.
# Options: 'openai' | 'claude' | 'gemini' | 'nvidia' | 'mock'
VISION_PROVIDER=openai

# Settings encryption — 32-byte key used to encrypt API keys stored in the DB
# via the admin dashboard. Set a STABLE value in production; keep it secret.
SETTINGS_ENC_KEY=change-me-to-a-stable-32-byte-secret

# Market Data (AI Trading Assistant) — optional.
# Crypto works LIVE via Binance public API with NO key.
# Forex/indices/commodities use TwelveData when a key is set, else mock.
TWELVEDATA_API_KEY=

# Voice Assistant — 'web-speech' (client-side, default) or 'openai' (Whisper/TTS)
VOICE_PROVIDER=web-speech
VOICE_OPENAI_API_KEY=

# Payments: SebPay Mobile Money — optional.
# Without SEBPAY_SECRET_KEY, payments run in DEMO mode (instant approval).
PAYMENT_PROVIDER=demo
PAYMENT_CURRENCY=XOF
SEBPAY_PUBLIC_KEY=
SEBPAY_SECRET_KEY=
SEBPAY_BASE_URL=https://new.sebpay.bj/api
# Public URL SebPay POSTs webhooks to (your deployed backend):
# https://<your-render-domain>/api/v1/payments/webhook/sebpay
SEBPAY_CALLBACK_URL=

# Email Configuration (for verification & password reset)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@aichartscanner.com

# Require a verified email (6-digit OTP) before scanning and other gated
# features. Set to 'true' once EMAIL_* above is configured. Default: off.
REQUIRE_EMAIL_VERIFICATION=true

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
# 10MB in bytes

# Rate Limiting
RATE_LIMIT_WINDOW=15
# minutes
RATE_LIMIT_MAX_REQUESTS=100

# Admin
ADMIN_EMAIL=admin@aichartscanner.com
ADMIN_PASSWORD=Admin123!ChangeThis
